<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/frIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:tint="?attr/cAccent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/frTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/cText"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/frDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/cText2"
                android:textSize="12sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/frSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/frLinks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/frAdd"
            style="@style/LinkBtn"
            android:layout_marginEnd="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/frExtra"
            style="@style/LinkBtn"
            android:layout_marginEnd="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/frExtra2"
            style="@style/LinkBtn"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
