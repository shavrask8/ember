<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_spark"
                android:tint="@color/accent" />
            <TextView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Claude"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:layout_marginStart="8dp"
                android:fontFamily="serif" />
            <TextView
                android:id="@+id/w_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/w_left"
                android:textColor="@color/text2"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/w_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="17:44"
                android:textColor="@color/text2"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/w_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/refresh"
                android:padding="7dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_s_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/w_session_5h"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/w_s_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="38%"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/w_s_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progressDrawable="@drawable/progress_bar"
                android:progress="38" />
        <TextView
                android:id="@+id/w_s_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pv_reset_s"
                android:textColor="@color/text2"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_w_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/week"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/w_w_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="88%"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/w_w_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progressDrawable="@drawable/progress_bar"
                android:progress="88" />
        <TextView
                android:id="@+id/w_w_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pv_reset_w"
                android:textColor="@color/text2"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
    </LinearLayout>
</FrameLayout>
