<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_spark"
                android:tint="@color/accent" />
            <TextView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Claude"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:layout_marginStart="8dp"
                android:fontFamily="serif" />
            <TextView
                android:id="@+id/w_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/w_stats"
                android:textColor="@color/text2"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/w_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="17:44"
                android:textColor="@color/text2"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/w_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/refresh"
                android:padding="7dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                android:id="@+id/w_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="4%"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:fontFamily="serif" />
                <TextView
                android:id="@+id/w_today_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/w_today_l"
                android:textColor="@color/text2"
                android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                android:id="@+id/w_sess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="38%"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:fontFamily="serif" />
                <TextView
                android:id="@+id/w_sess_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/session"
                android:textColor="@color/text2"
                android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                android:id="@+id/w_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="88%"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:fontFamily="serif" />
                <TextView
                android:id="@+id/w_week_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/week"
                android:textColor="@color/text2"
                android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/w_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
                android:src="@drawable/pv_bars" />
    </LinearLayout>
</FrameLayout>
