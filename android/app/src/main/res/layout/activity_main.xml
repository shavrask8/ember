<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_spark"
                android:tint="?attr/cAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/titleFont"
                    android:text="Claude"
                    android:textColor="?attr/cText"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_limits"
                    android:textColor="?attr/cText2"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/cText2" />

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                android:tint="?attr/cText2" />
        </LinearLayout>

        <!-- Перемикач сервісів (видно, коли їх кілька) -->
        <LinearLayout
            android:id="@+id/providerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Сесія -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/sessionTitle"
                style="@style/SectionTitle"
                android:text="@string/p_claude_session" />

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="14dp">

                <ua.shavra.claudelimits.RingView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ringPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/titleFont"
                        android:text="—"
                        android:textColor="?attr/cText"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/ringWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/cText2"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Простий рядок скидання (чистий режим) -->
            <TextView
                android:id="@+id/sessionReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="?attr/cText2"
                android:textSize="14sp" />

            <!-- Деталі сесії -->
            <LinearLayout
                android:id="@+id/detailsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tileReset"
                    layout="@layout/stat_tile" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/tileLeft"
                    layout="@layout/stat_tile" />
            </LinearLayout>

            <!-- Прогноз темпу -->
            <LinearLayout
                android:id="@+id/sessionPaceBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sessionPace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hint_ring"
                    android:textColor="?attr/cText2"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Тиждень -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/weekly_limits" />

            <include
                android:id="@+id/rowWeek"
                layout="@layout/row_limit" />

            <include
                android:id="@+id/rowOpus"
                layout="@layout/row_limit" />

            <include
                android:id="@+id/rowSonnet"
                layout="@layout/row_limit" />

            <LinearLayout
                android:id="@+id/weekPaceBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weekPace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hint_bar"
                    android:textColor="?attr/cText2"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Статистика -->
        <LinearLayout
            android:id="@+id/statsCard"
            style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/stats_7d" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stSessions"
                    layout="@layout/stat_tile" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/stHit"
                    layout="@layout/stat_tile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stAvg"
                    layout="@layout/stat_tile" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/stMaxDay"
                    layout="@layout/stat_tile" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/chart_days"
                android:textColor="?attr/cText"
                android:textSize="15sp" />

            <ua.shavra.claudelimits.BarChartView
                android:id="@+id/barChart"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/chart_24h"
                android:textColor="?attr/cText"
                android:textSize="15sp" />

            <ua.shavra.claudelimits.LineChartView
                android:id="@+id/lineChart"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/statsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/cText2"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/footer_main"
            android:textColor="?attr/cText2"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
